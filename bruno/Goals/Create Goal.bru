meta {
  name: Create Goal
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/goals
  body: json
  auth: none
}

body:json {
  {
    "name": "Emergency Fund",
    "amount": 1000.00,
    "savedAmount": 0,
    "reached": false
  }
}

script:post-response {
  var id = res.body.id
  bru.setEnvVar("goalId", id)
}
