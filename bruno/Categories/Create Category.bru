meta {
  name: Create Category
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Groceries",
    "type": "EXPENSE",
    "parentId": null
  }
}

script:post-response {
  var categoryId = res.body.id
  bru.setEnvVar("categoryId", categoryId)
}
