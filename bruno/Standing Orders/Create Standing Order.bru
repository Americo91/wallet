meta {
  name: Create Standing Order
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/accounts/:accountId/standing-orders
  body: json
  auth: none
}

params:path {
  accountId: {{accountId}}
}

body:json {
  {
    "name": "Spotify",
    "amount": 9.99,
    "currency": "EUR",
    "frequency": "MONTHLY",
    "type": "EXPENSE",
    "nextOccurrence": "2026-07-05",
    "category": "00000000-0000-0000-0000-000000000501",
    "description": "Spotify Premium subscription",
    "payee": "Spotify AB",
    "enabled": true,
    "labels": ["00000000-0000-0001-0000-000000000005"]
  }
}

script:post-response {
  bru.setEnvVar("standingOrderId", res.body.id)
}
