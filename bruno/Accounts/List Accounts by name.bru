meta {
  name: List Accounts by name
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/accounts?name=Revolut
  body: none
  auth: none
}

params:query {
  name: Revolut
}

vars:pre-request {
  baseUrl: http://localhost:8080
}

script:post-response {
  let data = res.body;
  let accountId = data[0].id;
  bru.setEnvVar("accountId", accountId)
}
